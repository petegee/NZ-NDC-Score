# Base URL of the running Soarscore API (no trailing slash), e.g.
#   VITE_API_BASE=http://localhost:5000
# The app fails fast at startup when this is unset.
VITE_API_BASE=

# Auth0 sign-in — set all three, or none to run anonymously against an API in
# Auth:Mode=none. AUDIENCE is the Soarscore API identifier the API is
# configured with (Soarscore__Auth__Audience).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
